# Exporte as variáveis no terminal; este arquivo não é carregado automaticamente.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgresql://workboard:password@localhost:5432/workboard
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required with DJANGO_DEBUG=false; optional for a single local process.
# REDIS_URL=redis://localhost:6379/0
PUBLIC_URL=http://127.0.0.1:5173
AUTH_RATE_LIMIT=10
