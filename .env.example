# Docker Compose: copy to .env and adjust before production.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-url-safe-password
DJANGO_ALLOWED_HOSTS=workboard.example.com
PUBLIC_URL=https://workboard.example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=WorkBoard <noreply@example.com>
